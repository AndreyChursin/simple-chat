# Optional. Copy to .env to override defaults; `docker compose up` works without it.

# Ports published on the host
APP_PORT=8080
MAILPIT_UI_PORT=8025

# Browser origin(s) of the app, comma-separated (first one is used in e-mail links).
APP_ORIGIN=http://localhost:8080

# PostgreSQL (applied on first start of the pgdata volume only)
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat

# SMTP for password reset e-mails. Default: Mailpit (UI at http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# MAIL_FROM=Chat <no-reply@chat.local>

# Lifetime of "Keep me signed in" sessions, days
# SESSION_TTL_DAYS=30
# LOG_LEVEL=INFO
